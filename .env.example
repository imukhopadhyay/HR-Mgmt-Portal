# ─── Copy to .env (local) — never commit real values. In Vercel, set these in
# ─── Project Settings → Environment Variables (separately for Preview/Production).

# PostgreSQL. Use a pooled URL for DATABASE_URL in serverless (e.g. PgBouncer / Neon pooler)
# and a direct (non-pooled) URL for migrations. Require TLS in production (sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hrportal?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hrportal?schema=public"

# Public base URL (used in emails / links). No trailing slash.
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""
SESSION_TTL_HOURS="12"

# File storage: "local" (dev only) or "s3" (any S3-compatible provider: AWS S3, Cloudflare R2, MinIO…)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Email: "console" (logs emails, dev), "smtp", or "disabled"
EMAIL_DRIVER="console"
EMAIL_FROM="HR Portal <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Shared secret for scheduled jobs (Vercel Cron sends it as a Bearer token). 16+ chars.
CRON_SECRET=""

LOG_LEVEL="info"

# Seed only (development): password assigned to all synthetic demo accounts.
SEED_PASSWORD=""
